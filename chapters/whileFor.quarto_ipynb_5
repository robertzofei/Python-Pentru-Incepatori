    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "value = 2\n",
        "match value:\n",
        "    case 1:\n",
        "        result = \"one\"\n",
        "    case 2:\n",
        "        result = \"two\"\n",
        "    case 3:\n",
        "        result = \"three\"\n",
        "    case _:\n",
        "        result = \"unknown\"\n",
        "print(result)"
